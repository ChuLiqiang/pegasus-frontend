# ignore build dir
build*/

# ignore all dotfiles
./.*

# except these
!.gitignore
!.qmake.conf
!.appveyor.yml
!.circleci/
!.travis/
!.github/

# ignore IDE project files
*.pro.user
*.kdev4
*.workspace

# ignore Qt generated files
*.qmlc
*.jsc
*.autosave

# ignore in-tree qmake build artifacts (this checkout was built in-place,
# not in a separate build*/ dir)
*.o
*.a
*.moc
Makefile
Makefile.*
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
.qmake.stash
*.app/
object_script.*
src/app/.qm/
*_qml.cpp
*_qmlcache.qrc
qmlcache_loader.cpp
qmake_qmake_qm_files.qrc
target_wrapper.sh
.._*_qml.cpp
